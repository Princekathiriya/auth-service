# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
# The React demo's URL — only this origin is allowed by CORS.
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=info
MONGODB_URI=mongodb://localhost:27017/auth-service
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SAMESITE=strict
# console = print emails to the terminal (dev). resend = really send (get a key at resend.com).
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=Auth Service <onboarding@resend.dev>
# Google OAuth (optional). Create credentials at console.cloud.google.com > APIs & Services > Credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Locally: http://localhost:4000/auth/google/callback
GOOGLE_REDIRECT_URI=
