# Where the browser sends API requests.
#   Local dev:  http://localhost:4000
#   Vercel:     /api   (same origin; vercel.json forwards /api/* to the API on Render)
# Vite only exposes VITE_* variables to the browser, and EVERYTHING here ends up in the public
# JS bundle: never put secrets in a frontend .env.
VITE_API_URL=http://localhost:4000
